rules_version = '2';

// Medelec Healthcare Solutions (MHS) — Firestore security rules.
// Translates the previous Supabase RLS policies:
//   - products:  public read of published items, authenticated admins for all
//   - inquiries: anyone may submit, authenticated admins may read
service cloud.firestore {
  match /databases/{database}/documents {

    // Public product catalog (medical equipment)
    match /products/{productId} {
      // Visitors may only read published products; admins read everything.
      allow read: if resource.data.is_published == true || request.auth != null;
      // Catalog management is restricted to authenticated admin users
      // (accounts are created via the Firebase console only — no public signup).
      allow create, update, delete: if request.auth != null;
    }

    // Contact form & RFQ submissions
    match /inquiries/{inquiryId} {
      // Any visitor may submit an inquiry.
      allow create: if true;
      // Only authenticated admin users may read submitted inquiries.
      // (No update/delete — same as the previous Supabase policies.)
      allow read: if request.auth != null;
    }
  }
}
